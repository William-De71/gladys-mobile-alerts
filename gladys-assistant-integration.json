            "de": "Deutsch",
            "es": "Deutsch"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Español",
            "fr": "Español",
            "de": "Español",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "read_now",
      "timeout_seconds": 60,
      "label": {
        "en": "Read now",
        "fr": "Lire maintenant",
        "de": "Jetzt lesen",
